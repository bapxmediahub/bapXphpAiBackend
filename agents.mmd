flowchart LR
  classDef role fill:#fff7ed,stroke:#9f1239,color:#4c0519
  classDef event fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e
  classDef tool fill:#ecfdf5,stroke:#047857,color:#064e3b
  classDef gate fill:#fef3c7,stroke:#b45309,color:#78350f

  subgraph EVENTS["GitHub and deployment events"]
    github_issue["Issue opened or @bapXai mentioned"]:::event
    branch_push["Implementation branch pushed"]:::event
    pull_request["Pull request updated"]:::event
    deployment["Deployment main merged"]:::event
  end

  subgraph ROLES["Sequential agent roles"]
    cto["CTO<br/><small>.agents/workflows/cto-workflow.md</small>"]:::role
    worker["Worker<br/><small>.agents/workflows/worker.md</small>"]:::role
    reviewer["Reviewer<br/><small>.agents/workflows/reviewer.md</small>"]:::role
    browser_tester["Browser Tester<br/><small>.agents/workflows/browser-tester.md</small>"]:::role
  end

  subgraph TOOLS["Guaranteed scripts and tools"]
    map["Generate and validate maps<br/><small>bapXphp update</small>"]:::tool
    ci["Lint, tests, maps, smoke<br/><small>bapXphp ci</small>"]:::tool
    score["Score handoff evidence<br/><small>bapXphp handoff score <issue></small>"]:::tool
    browser["Capture rendered evidence<br/><small>bapXphp browser-agent</small>"]:::tool
  end

  github_issue -->|scope| cto
  cto -->|one objective| worker
  worker -->|deterministic checks| ci
  ci -->|evidence| reviewer
  reviewer -->|UI objective| browser_tester
  reviewer -->|pass| cto
  reviewer -->|gap or blocked| worker
  browser_tester -->|rendered verdict| cto
  cto -->|acceptance| score
  score -->|score >= gate| pull_request
  pull_request -->|merge| deployment
  deployment -->|live verification| browser_tester
  browser_tester -->|close or reopen| cto

  telemetry["Telemetry<br/><small>status, started_at, completed_at, duration_seconds, attempts, tool_failures, evidence_count, reviewer_findings, regressions, score</small><br/>minimum score 90"]:::gate
  worker -. records .-> telemetry
  reviewer -. verifies .-> telemetry
  browser_tester -. renders .-> telemetry
  score -. aggregates .-> telemetry
