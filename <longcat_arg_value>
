function initHeroParticles() {
    const container = $('#hero-particles');
    if (!container) return;
    
    container.innerHTML = '';
    for (let i = 0; i < 20; i++) {
        const particle = document.createElement('span');
        particle.className = 'particle';
        particle.style.setProperty('--particle-x', Math.random() * 100 + '%');
        particle.style.setProperty('--particle-y', Math.random() * 100 + '%');
        particle.style.setProperty('--particle-delay', Math.random() * 5 + 's');
        particle.style.setProperty('--particle-duration', (3 + Math.random() * 4) + 's');
        container.appendChild(particle);
    }
}

function initHeroAnimations() {
    $$('.hero-animate').forEach(el => {
        const delay = parseInt(el.dataset.delay) || 0;
        slideUp(el, delay);
    });
}

