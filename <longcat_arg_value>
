// ============================================
// Product Detail Page
// ============================================
function ProductPage({ slug }) {
    const container = Container({ narrow: true });
    const product = Store.state.products.find(p => p.slug === slug);
    
    if (!product) {
        container.innerHTML = `
            <div class="empty-state reveal">
                <div class="empty-state-icon">🔍</div>
                <h2>Product Not Found</h2>
                <p>The item you're looking for is unavailable.</p>
                <a href="/shop" data-link class="btn btn-primary mt-lg">Browse Shop</a>
            </div>
        `;
        return container;
    }
    
    const hasOffer = product.offer_price && product.offer_price < product.price;
    const discount = hasOffer ? Math.round((1 - product.offer_price / product.price) * 100) : 0;
    const related = Store.state.products.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);
    
    container.innerHTML = `
        <div class="product-detail">
            <div class="product-gallery reveal">
                <div class="product-gallery__main">
                    <img src="${img(product.image_url, product.name)}" alt="${esc(product.name)}" id="main-product-image">
                </div>
            </div>
            <div class="product-info reveal" data-delay="100">
                <nav class="breadcrumb">
                    <a href="/" data-link>Home</a> / <a href="/shop" data-link>Shop</a> / <span>${esc(product.name)}</span>
                </nav>
                ${product.category ? `<span class="product-category">${esc(product.category)}</span>` : ''}
                <h1 class="product-title">${esc(product.name)}</h1>
                <div class="product-info__price">
                    <span class="price price--large">${fmt(product.offer_price || product.price)}</span>
                    ${hasOffer ? `<span class="old-price old-price--large">${fmt(product.price)}</span><span class="badge badge--success">Save ${discount}%</span>` : ''}
                </div>
                <p class="product-desc">${esc(product.description)}</p>
                <div class="product-form">
                    <div class="qty-input">
                        <button class="qty-btn" id="qty-minus">−</button>
                        <input type="number" value="1" min="1" max="99" id="qty-input">
                        <button class="qty-btn" id="qty-plus">+</button>
                    </div>
                    <button class="btn btn-primary btn-lg btn-glow" id="add-to-cart-btn" data-product='${esc(JSON.stringify(product))}'>
                        <span class="btn-icon">🛒</span> Add to Cart
                    </button>
                    <a href="/checkout" data-link class="btn btn-outline btn-lg">
                        <span class="btn-icon">⚡</span> Buy Now
                    </a>
                </div>
                <div class="product-features">
                    <div class="product-feature">
                        <span class="feature-badge">🔒</span>
                        <span>Secure Payment</span>
                    </div>
                    <div class="product-feature">
                        <span class="feature-badge">📦</span>
                        <span>Fast Delivery</span>
                    </div>
                    <div class="product-feature">
                        <span class="feature-badge">✓</span>
                        <span>Authentic Product</span>
                    </div>
                    <div class="product-feature">
                        <span class="feature-badge">✨</span>
                        <span>Blessed & Energized</span>
                    </div>
                </div>
            </div>
        </div>
        
        ${related.length > 0 ? `
            <section class="related-products reveal">
                <h2 class="section-title">Related Products</h2>
                <div class="product-grid">
                    ${related.map((p, i) => {
                        const relHasOffer = p.offer_price && p.offer_price < p.price;
                        return `
                            <article class="product-card reveal" data-delay="${i * 50}">
                                <div class="product-card__image">
                                    <img src="${img(p.image_url, p.name)}" alt="${esc(p.name)}" loading="lazy">
                                    ${relHasOffer ? `<span class="product-card__badge product-card__badge--sale">Sale</span>` : ''}
                                    <div class="product-card__overlay">
                                        <a href="/product/${p.slug}" data-link class="btn btn-sm btn-ghost">Quick View</a>
                                    </div>
                                </div>
                                <div class="product-card__body">
                                    <h3 class="product-card__title">${esc(p.name)}</h3>
                                    <div class="product-card__price-row">
                                        <span class="price">${fmt(p.offer_price || p.price)}</span>
                                    </div>
                                </div>
                            </article>
                        `;
                    }).join('')}
                </div>
            </section>
        ` : ''}
    `;
    
    // Bind quantity and add to cart
    requestAnimationFrame(() => {
        const qtyInput = container.querySelector('#qty-input');
        const minusBtn = container.querySelector('#qty-minus');
        const plusBtn = container.querySelector('#qty-plus');
        const addBtn = container.querySelector('#add-to-cart-btn');
        
        minusBtn?.addEventListener('click', () => {
            qtyInput.value = Math.max(1, parseInt(qtyInput.value) - 1);
        });
        
        plusBtn?.addEventListener('click', () => {
            qtyInput.value = Math.min(99, parseInt(qtyInput.value) + 1);
        });
        
        addBtn?.addEventListener('click', () => {
            const qty = parseInt(qtyInput.value) || 1;
            Cart.add(product, qty);
            showNotification(`${product.name} (${qty}) added to cart!`, 'success');
        });
    });
    
    return container;
}

// ============================================
// Cart Page
// ============================================
function CartPage() {
    const container = Container();
    
    if (Cart.items.length === 0) {
        container.innerHTML = `
            <div class="empty-state reveal">
                <div class="empty-state-icon">🛒</div>
                <h2>Your Cart is Empty</h2>
                <p>Add some spiritual products to get started.</p>
                <a href="/shop" data-link class="btn btn-primary btn-lg mt-lg">Continue Shopping</a>
            </div>
        `;
        return container;
    }
    
    container.innerHTML = `
        <div class="page-header reveal">
            <h1 class="page-title">Shopping Cart</h1>
            <p class="page-subtitle">${Cart.items.length} item${Cart.items.length !== 1 ? 's' : ''} in your cart</p>
        </div>
        <div class="cart-layout">
            <div class="cart-items" id="cart-items">
                ${Cart.items.map((item, i) => {
                    const price = item.offer_price || item.price || 0;
                    const lineTotal = price * item.qty;
                    return `
                        <div class="cart-item reveal" data-delay="${i * 50}" data-slug="${item.slug}">
                            <div class="cart-item__image">
                                <img src="${img(item.image_url, item.name)}" alt="${esc(item.name)}">
                            </div>
                            <div class="cart-item__details">
                                <a href="/product/${item.slug}" data-link class="cart-item__name">${esc(item.name)}</a>
                                <p class="cart-item__meta">${esc(item.category || 'Spiritual Product')}</p>
                                <p class="cart-item__price-each">${fmt(price)} each</p>
                            </div>
                            <div class="cart-item__qty">
                                <button class="qty-btn qty-btn--small" data-action="decrease">−</button>
                                <span class="qty-value">${item.qty}</span>
                                <button class="qty-btn qty-btn--small" data-action="increase">+</button>
                            </div>
                            <div class="cart-item__total">
                                <span class="cart-item__total-price">${fmt(lineTotal)}</span>
                                <button class="cart-item__remove" data-action="remove">🗑️</button>
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>
            <div class="cart-summary reveal" data-delay="200">
                <h2>Order Summary</h2>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>${fmt(Cart.total)}</span>
                </div>
                <div class="summary-row">
                    <span>Shipping</span>
                    <span class="text-success">FREE</span>
                </div>
                <div class="summary-row summary-row--total">
                    <span>Total</span>
                    <span class="summary-total">${fmt(Cart.total)}</span>
                </div>
                <a href="/checkout" data-link class="btn btn-primary btn-lg btn-block mt-lg">
                    <span class="btn-icon">🔒</span> Proceed to Checkout
                </a>
                <a href="/shop" data-link class="btn btn-ghost btn-block mt-sm">← Continue Shopping</a>
            </div>
        </div>
    `;
    
    // Bind cart actions
    requestAnimationFrame(() => bindCartActions(container));
    
    return container;
}

