function bindAddToCartButtons(container) {
    container?.querySelectorAll('.btn-add-cart').forEach(btn => {
        btn.addEventListener('click', (e) => {
            try {
                const productStr = btn.dataset.product.replace(/&quot;/g, '"');
                const product = JSON.parse(productStr);
                Cart.add(product, 1);
                showNotification(`${product.name} added to cart!`, 'success');
                
                // Animate to cart
                const card = btn.closest('.product-card, .showcase-card');
                const img = card?.querySelector('img');
                if (img) animateToCart(img, e);
            } catch (err) {
                console.error('Error adding to cart:', err);
            }
        });
    });
}

function bindCartActions(container) {
    container.querySelectorAll('.cart-item').forEach(item => {
        const slug = item.dataset.slug;
        
        item.querySelector('[data-action="increase"]')?.addEventListener('click', () => {
            const qtyEl = item.querySelector('.qty-value');
            const qty = parseInt(qtyEl.textContent) + 1;
            Cart.updateQty(slug, qty);
            qtyEl.textContent = qty;
        });
        
        item.querySelector('[data-action="decrease"]')?.addEventListener('click', () => {
            const qtyEl = item.querySelector('.qty-value');
            const qty = parseInt(qtyEl.textContent);
            if (qty > 1) {
                Cart.updateQty(slug, qty - 1);
                qtyEl.textContent = qty - 1;
            } else {
                Cart.remove(slug);
                item.remove();
                Router.render(Router.currentPath);
            }
        });
        
        item.querySelector('[data-action="remove"]')?.addEventListener('click', () => {
            Cart.remove(slug);
            item.remove();
            if (Cart.items.length === 0) {
                Router.render(Router.currentPath);
            }
        });
    });
}

function bindCategoryFilters() {
    $$('#category-filters .filter-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            $$('#category-filters .filter-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            
            const category = chip.dataset.category;
            $$('#shop-product-grid .product-card').forEach(card => {
                if (!category || card.dataset.category === category) {
                    card.style.display = '';
                    slideUp(card, 0);
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });
}

function bindSorting() {
    const sortSelect = $('#sort-select');
    sortSelect?.addEventListener('change', (e) => {
        const grid = $('#shop-product-grid');
        const cards = [...$$('.product-card', grid)];
        
        cards.sort((a, b) => {
            const getPrice = card => {
                const priceText = card.querySelector('.price')?.textContent || '0';
                return parseInt(priceText.replace(/[^0-9]/g, ''));
            };
            
            switch (e.target.value) {
                case 'price-low': return getPrice(a) - getPrice(b);
                case 'price-high': return getPrice(b) - getPrice(a);
                default: return 0;
            }
        });
        
        cards.forEach((card, i) => {
            grid.appendChild(card);
            card.dataset.delay = i * 30;
            slideUp(card, i * 30);
        });
    });
}

function bindSlotBooking(container, astrologer) {
    container?.querySelectorAll('[data-action="book-slot"]').forEach(btn => {
        btn.addEventListener('click', () => {
            const time = btn.closest('.slot-card').dataset.time;
            showNotification(`Booking ${astrologer.name} at ${time}...`, 'info');
        });
    });
}

function generateTimeSlots() {
    const slots = [];
    for (let h = 9; h <= 18; h++) {
        slots.push(`${h.toString().padStart(2, '0')}:00`);
        if (h < 18) slots.push(`${h.toString().padStart(2, '0')}:30`);
    }
    return slots;
}

