# ── Colors ─────────────────────────────────────────────────────
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; B='\033[1m'; N='\033[0m'

# ── Helpers ────────────────────────────────────────────────────
hr()  { printf "%$(tput cols)s\n" | tr ' ' '═'; }
hr2() { printf "%$(tput cols)s\n" | tr ' ' '─'; }
info() { printf "${C}%s${N}\n" "$*"; }
ok()   { printf "${G}%s${N}\n" "$*"; }
warn() { printf "${Y}%s${N}\n" "$*" >&2; }
err()  { printf "${R}%s${N}\n" "$*" >&2; }

die()  { err "$*"; exit 1; }

require_php() { command -v php >/dev/null 2>&1 || die "PHP is not installed"; }
require_gh()  { command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) is not installed"; }

schema_path() { echo "$SCHEMA_FILE"; }

# Test if remote SSH is reachable
ssh_reachable() {
  nc -z -w5 "$SSH_HOST" "$SSH_PORT" 2>/dev/null
}

# Run a command on remote via SSH (expects sshpass or manual ssh)
remote_sh() {
  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -p "$SSH_PORT" "${SSH_USER}@${SSH_HOST}" "$*" 2>/dev/null
  else
    ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 -p "$SSH_PORT" "${SSH_USER}@${SSH_HOST}" "$*" 2>/dev/null
  fi
}

# ── Commands ───────────────────────────────────────────────────

cmd_help() {
  awk '
    /^# ═+$/ { c++; if (c == 2) { capturing = 1; next } if (c == 3) { exit } }
    capturing { sub(/^# ?/, ""); print }
  ' "${BASH_SOURCE[0]}"
}

# ── understand ─────────────────────────────────────────────────
cmd_understand() {
  require_php

  local branch="" last_commit="" git_status="" dirty=""
  branch=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
  last_commit=$(git -C "$ROOT" log --oneline -1 2>/dev/null || echo "?")
  dirty=$(git -C "$ROOT" status --short 2>/dev/null | wc -l | tr -d ' ')
  [ "$dirty" -gt 0 ] && git_status="${dirty} modified/staged" || git_status="clean"

  echo ""
  printf "${B}${C}%s${N}${B}%s${N}\n" "╔══════════════════════════════════════════╗" ""
  printf "${B}${C}%s${N}${B}%s${N}\n" "║" "          bapXphp understand" ""
  printf "${B}${C}%s${N}${B}%s${N}\n" "╚══════════════════════════════════════════╝" ""
  echo ""

  # ── Repository ──
  printf "${B}── Repository ──────────────────────────────${N}\n"
  echo "  Branch:      ${branch}"
  echo "  Last commit: ${last_commit}"
  echo "  Status:      ${git_status}"
  echo ""

  # ── Recent commits ──
  printf "${B}── Recent Commits ──────────────────────────${N}\n"
  git -C "$ROOT" log --oneline -5 2>/dev/null | sed 's/^/  /'
  echo ""

  # ── Open Issues (gh) ──
  if command -v gh >/dev/null 2>&1; then
    local issues
    issues=$(gh issue list --state open --limit 10 --json number,title,createdAt 2>/dev/null) || issues=""
    if [ -n "$issues" ] && [ "$issues" != "[]" ]; then
      printf "${B}── Open Issues ────────────────────────────${N}\n"
      echo "$issues" | php -r '
        $items = json_decode(stream_get_contents(STDIN), true);
        foreach ($items as $i) printf("  #%d  %s (opened %s)\n", $i["number"], $i["title"], substr($i["createdAt"],0,10));
      '
      echo ""
    fi
  fi

  # ── Recent Merged PRs (gh) ──
  if command -v gh >/dev/null 2>&1; then
    local prs
    prs=$(gh pr list --state merged --limit 5 --json number,title,mergedAt 2>/dev/null) || prs=""
    if [ -n "$prs" ] && [ "$prs" != "[]" ]; then
      printf "${B}── Recent PRs Merged ───────────────────────${N}\n"
      echo "$prs" | php -r '
        $items = json_decode(stream_get_contents(STDIN), true);
        foreach ($items as $i) printf("  #%d  %s (merged %s)\n", $i["number"], $i["title"], substr($i["mergedAt"],0,10));
      '
      echo ""
    fi
  fi

  # ── Schema Collections ──
  if [ -f "$SCHEMA_FILE" ]; then
    printf "${B}── Schema Collections ──────────────────────${N}\n"
    php -r "
      \$s = json_decode(file_get_contents('$SCHEMA_FILE'), true);
      foreach (\$s['collections'] ?? [] as \$name => \$col) {
        echo \"  ${B}\${name}${N}\n\";
        echo \"    file:    \" . (\$col['file'] ?? '-') . \"\n\";
    echo \"    pkey:    \" . (\$col['primary_key'] ?? '-') . \"\n\";
    echo \"    managed: \" . ((\$col['admin_managed'] ?? false) ? 'admin' : 'runtime') . \"\n\";
        if (\$col['admin_fields'] ?? []) echo \"    a_fields: \" . implode(', ', \$col['admin_fields']) . \"\n\";
        if (\$col['media_fields'] ?? []) echo \"    m_fields: \" . implode(', ', \$col['media_fields']) . \"\n\";
        if (\$col['agent_context'] ?? []) echo \"    context:  \" . implode(', ', \$col['agent_context']) . \"\n\";
        echo \"\";
        foreach (\$col['fields'] ?? [] as \$fname => \$fdef) {
          \$req = !empty(\$fdef['required']) ? ' (required)' : '';
          \$vals = isset(\$fdef['values']) ? ' [' . implode(', ', \$fdef['values']) . ']' : '';
          \$items = isset(\$fdef['items']) ? ' of ' . \$fdef['items'] : '';
          echo \"    ├─ \$fname: \" . \$fdef['type'] . \$items . \$vals . \$req . \"\n\";
        }
      }
    "
    echo ""
  fi

  # ── Skills ──
  local skills_root="$ROOT/.agents/skills"
  printf "${B}── Skills ──────────────────────────────────${N}\n"
  if [ -d "$skills_root" ]; then
    for skill_dir in "$skills_root"/*/; do
      [ -d "$skill_dir" ] || continue
      local sname; sname=$(basename "$skill_dir" 2>/dev/null) || true
      local sdesc
      sdesc=$(head -3 "$skill_dir/SKILL.md" 2>/dev/null | tail -1 | sed 's/^#* *//') || true
      sdesc="${sdesc:-Use when editing $sname tasks}"
      printf "  • %s  %s\n" "$sname" "$sdesc"
    done
  else
    echo "  (no skills directory found)"
  fi
  echo ""

  # ── AGENTS.md root excerpt ──
  if [ -f "$ROOT/AGENTS.md" ]; then
    printf "${B}── AGENTS.md Root (excerpt) ───────────────${N}\n"
    grep -v '^---$' "$ROOT/AGENTS.md" | grep -v '^globs:' | grep -v '^alwaysApply:' | grep -v '^description:' | head -12 | sed 's/^/  /'
    echo ""
  fi

  # ── Quick Reference ──
  printf "${B}── Quick Reference ─────────────────────────${N}\n"
  printf "  ${C}bapXphp test${N}        php tests/run.php\n"
  printf "  ${C}bapXphp serve${N}       php -S 127.0.0.1:6020 index.php\n"
  printf "  ${C}bapXphp check${N}       lint → test → map:gen → map:val → smoke\n"
  printf "  ${C}bapXphp db query <col>${N}  --where 'field=val' --limit 10\n"
  printf "  ${C}bapXphp db tunnel${N}   SSH tunnel → remote MySQL\n"
  printf "  ${C}bapXphp db init${N}     create MySQL tables from schema\n"
  printf "  ${C}bapXphp db sync${N}     push JSON → MySQL\n"
  printf "  ${C}bapXphp understand${N}  Full project overview\n"
  printf "  ${C}bapXphp help${N}        All commands\n"
  echo ""
}

