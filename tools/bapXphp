SSH_HOST="${BAPX_SSH_HOST:-82.25.106.244}"
SSH_PORT="${BAPX_SSH_PORT:-65002}"
SSH_USER="${BAPX_SSH_USER:-u907253411}"
SSH_PASS="${BAPX_SSH_PASS:-SPsprituals2026#}"
MYSQL_TUNNEL_PORT="${BAPX_MYSQL_TUNNEL_PORT:-3307}"
