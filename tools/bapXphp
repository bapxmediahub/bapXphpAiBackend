#!/usr/bin/env bash
set -euo pipefail

# ═══════════════════════════════════════════════════════════════
# bapXphp — Project management CLI for the PHP/JSON monorepo
# ═══════════════════════════════════════════════════════════════
# Usage: bapXphp <command> [args...]
#
# ── Orientation ─────────────────────────────────────────────────
#   bapXphp help                    — this message
#   bapXphp understand              — full project overview (schema, commits, issues, PRs, skills, AGENTS.md)
#   bapXphp context                 — quick session orientation (branch, status, last test result)
#
# ── Development ─────────────────────────────────────────────────
#   bapXphp test                    — run test suite (php tests/run.php)
#   bapXphp lint [path]             — PHP syntax check (php -l)
#   bapXphp check                   — full validation chain: lint → test → map:gen → map:val → smoke
#   bapXphp serve                   — start dev server on 127.0.0.1:6020
#   bapXphp smoke                   — run local smoke tests
#
# ── Project Map ─────────────────────────────────────────────────
#   bapXphp map                     — view generated project map
#   bapXphp map:gen                 — regenerate project map from source
#   bapXphp map:val                 — validate map is up-to-date
#
# ── Schema (collections.json) ───────────────────────────────────
#   bapXphp schema list             — list all collections with field counts
#   bapXphp schema show <col>       — show full collection schema (fields, types, constraints)
#   bapXphp add <field>:<type> [opts] under <collection>
#                                   — add a field to collection schema
#                                     opts: required:true values:a,b,c items:string
#   bapXphp remove <field> under <collection>
#                                   — remove a field from collection schema
#
# ── Tool Management ─────────────────────────────────────────────
#   bapXphp tool list               — list all PHP tools in tools/
#   bapXphp tool add <file>         — create a new PHP tool with nano editor
#
# ── Skills & Routes ─────────────────────────────────────────────
#   bapXphp skills                  — list available agent skills with descriptions
#   bapXphp route:list              — list all registered routes with controllers
#
# ── Git ─────────────────────────────────────────────────────────
#   bapXphp status                  — git status + recent commits
#   bapXphp logs                    — tail recent error logs from storage/data/
#
# ── GitHub ──────────────────────────────────────────────────────
#   bapXphp issue                   — create a GitHub issue (interactive via gh CLI)
#   bapXphp pr                      — create a GitHub PR (interactive)
#   bapXphp merge                   — merge a GitHub PR (interactive)
#
# ── Mail & Images ───────────────────────────────────────────────
#   bapXphp mail:process            — process pending mail queue
#   bapXphp images:optimize         — convert/resize images to WebP
#
# ── Database (MySQL only) ────────────────────────────────────────
#   bapXphp db tables               — list all MySQL tables (from live DB via SSH tunnel)
#   bapXphp db describe <table>     — describe MySQL table columns
#   bapXphp db list                 — list all schema collections (from collections.json)
#   bapXphp db show <collection>    — show schema collection fields & types
#   bapXphp db query <collection> [--where "field=value"] [--limit N] [--id id] [--owner email]
#                                   — query records from MySQL (no JSON fallback)
#   bapXphp db find <collection> <id>
#                                   — shorthand: find record by ID
#   bapXphp db raw <sql>            — execute raw SQL on remote MySQL
#   bapXphp db init                 — create MySQL tables from collections.json schema
#   bapXphp db sync                 — push JSON data files → MySQL tables
#   bapXphp db tunnel               — open SSH tunnel to remote MySQL
#
# ── Blog & Docs ──────────────────────────────────────────────────
#   bapXphp docsmap                 — regenerate KnowledgeMap.mmd from docs/ + AGENTS.md + skills
#   bapXphp bloggen                 — regenerate blog cache from GitHub markdown sources
#
# ── Deploy & SSH ────────────────────────────────────────────────
#   bapXphp deploy                  — git push + remote pull (deploy to production)
#   bapXphp ssh                     — SSH into production server
#
# ── Backward compatibility aliases ──────────────────────────────
#   bapXphp mysql:tunnel  → bapXphp db tunnel
#   bapXphp mysql:query   → bapXphp db raw
#   bapXphp mysql:import  → bapXphp db sync
# ═══════════════════════════════════════════════════════════════

