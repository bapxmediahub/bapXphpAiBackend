# ═══════════════════════════════════════════════════════════════
# Database Commands (db) — MySQL via SSH tunnel + JSON fallback
# ═══════════════════════════════════════════════════════════════
# The `db` command suite lets the agent query and inspect project data
# the same way it accesses JSON collections. When the SSH tunnel to
# the production MySQL is active, all queries hit the live database.
# When the tunnel is inactive, `db query` falls back to reading from
# the local JSON files in storage/data/.
#
# Connection priority: SSH tunnel (127.0.0.1:3307) → direct remote → JSON files
#
# See the collections.json schema for the authoritative field definitions.
# JSON collection name == MySQL table name (underscored).
#
# MySQL schema per table:
#   id          VARCHAR(36) PK   — record ID (matches JSON primary_key)
#   _data       JSON NOT NULL    — full record data (same as JSON file contents)
#   _owner      VARCHAR(255)     — owner email (for owner_field collections)
#   _status     VARCHAR(50)      — record status (for indexed lookups)
#   _created_at DATETIME         — creation timestamp
#   _updated_at DATETIME         — last update timestamp
# ═══════════════════════════════════════════════════════════════

# ── db <command> ───────────────────────────────────────────────
# Entry point: bapXphp db <subcommand> [args]
# Subcommands: tables, describe, list, show, query, find, raw, init, sync, tunnel
cmd_db() {
  local action="${1:-help}"
  shift 2>/dev/null || true
  case "$action" in
    tables|list)      cmd_db_tables "$@" ;;
    describe|desc)    cmd_db_describe "$1" ;;
    show)             cmd_db_show "$1" ;;
    query)            cmd_db_query "$@" ;;
    find)             cmd_db_find "$1" "$2" ;;
    raw|sql)          cmd_db_raw "$*" ;;
    init)             cmd_db_init ;;
    sync|import)      cmd_db_sync ;;
    tunnel)           cmd_db_tunnel ;;
    help|*)           cmd_db_help ;;
  esac
}

cmd_db_help() {
  echo "Database commands — query MySQL (via SSH tunnel) or fall back to JSON files."
  echo ""
  echo "  bapXphp db tables              — list MySQL tables from remote DB"
  echo "  bapXphp db describe <table>    — describe MySQL table columns"
  echo "  bapXphp db list                — list all collections from schema"
  echo "  bapXphp db show <collection>   — show schema collection fields"
  echo "  bapXphp db query <collection> [--where 'f=v'] [--limit N] [--id id]"
  echo "  bapXphp db find <collection> <id>  — find record by ID"
  echo "  bapXphp db raw <sql>           — execute raw SQL on remote MySQL"
  echo "  bapXphp db init                — create MySQL tables from collections.json"
  echo "  bapXphp db sync                — push JSON data files → MySQL tables"
  echo "  bapXphp db tunnel              — open SSH tunnel to remote MySQL"
  echo ""
  echo "Connection: tunnel (127.0.0.1:3307) → direct (remote) → JSON fallback"
  echo "Config env vars: BAPX_SSH_HOST, BAPX_MYSQL_HOST, BAPX_MYSQL_DB, BAPX_MYSQL_USER, BAPX_MYSQL_PASS"
}

# ── db tunnel — Open SSH tunnel to remote MySQL ─────────────────
# Creates a local tunnel: 127.0.0.1:3307 → srv1877.hstgr.io:3306
# Requires sshpass. After opening, MySQL is accessible at localhost:3307.
cmd_db_tunnel() {
  echo "Opening SSH tunnel to $SSH_HOST:$SSH_PORT"
  echo "  → localhost:$MYSQL_TUNNEL_PORT → $MYSQL_HOST:$MYSQL_PORT"
  echo ""

  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no -f -L "${MYSQL_TUNNEL_PORT}:${MYSQL_HOST}:${MYSQL_PORT}" \
      -p "$SSH_PORT" "${SSH_USER}@${SSH_HOST}" -N 2>&1 || {
      warn "Tunnel failed. Server may be unreachable."
      exit 1
    }
    ok "Tunnel open. MySQL ready:"
    echo "  mysql -h 127.0.0.1 -P $MYSQL_TUNNEL_PORT -u $MYSQL_USER -p$MYSQL_PASS $MYSQL_DB"
  else
    warn "sshpass not found. Install: brew install hudochenkov/sshpass/sshpass"
    echo ""
    echo "Or run manually:"
    echo "  ssh -p $SSH_PORT -L ${MYSQL_TUNNEL_PORT}:${MYSQL_HOST}:${MYSQL_PORT} ${SSH_USER}@${SSH_HOST}"
    exit 1
  fi
}

