# ── Schema Commands ────────────────────────────────────────────
cmd_schema() {
  local action="${1:-list}"
  shift 2>/dev/null || true
  case "$action" in
    list) cmd_schema_list "$@" ;;
    show) cmd_schema_show "$1" ;;
    *)    cmd_schema_list ;;
  esac
}

cmd_schema_list() {
  [ -f "$SCHEMA_FILE" ] || die "Schema file not found: $SCHEMA_FILE"
  php -r "
    \$s = json_decode(file_get_contents('$SCHEMA_FILE'), true);
    echo \"Collections (\" . count(\$s['collections'] ?? []) . \"):\n\";
    foreach (\$s['collections'] ?? [] as \$name => \$col) {
      \$c = count(\$col['fields'] ?? []);
      \$f = \$col['file'] ?? '-';
      echo \"  \$name  (\$c fields, \$f)\n\";
    }
  "
}

cmd_schema_show() {
  local collection="$1"
  [ -z "$collection" ] && die "Usage: bapXphp schema show <collection>"
  [ -f "$SCHEMA_FILE" ] || die "Schema file not found: $SCHEMA_FILE"
  php -r "
    \$s = json_decode(file_get_contents('$SCHEMA_FILE'), true);
    \$col = \$s['collections']['$collection'] ?? null;
    if (!\$col) { fprintf(STDERR, \"Collection '$collection' not found\n\"); exit(1); }
    echo \"Collection: $collection\n\";
    echo \"File:       \" . (\$col['file'] ?? '-') . \"\n\";
    echo \"PKey:       \" . (\$col['primary_key'] ?? '-') . \"\n\";
    echo \"Managed:    \" . (\$col['admin_managed'] ? 'admin' : 'runtime') . \"\n\";
    if (\$col['admin_fields'] ?? []) echo \"Admin flds: \" . implode(', ', \$col['admin_fields']) . \"\n\";
    if (\$col['media_fields'] ?? []) echo \"Media flds: \" . implode(', ', \$col['media_fields']) . \"\n\";
    if (\$col['agent_context'] ?? []) echo \"Context:    \" . implode(', ', \$col['agent_context']) . \"\n\";
    echo \"\nFields:\n\";
    foreach (\$col['fields'] ?? [] as \$fname => \$fdef) {
      \$req = !empty(\$fdef['required']) ? ' required' : '';
      \$vals = isset(\$fdef['values']) ? ' [' . implode(', ', \$fdef['values']) . ']' : '';
      \$items = isset(\$fdef['items']) ? ' of ' . \$fdef['items'] : '';
      echo \"  \$fname: \" . \$fdef['type'] . \$items . \$vals . \$req . \"\n\";
    }
  "
}

cmd_add() {
  local field_spec="" collection=""
  local args=()

  # Parse: bapXphp add <field>:<type> [opts] under <collection>
  while [ $# -gt 0 ]; do
    case "$1" in
      under) shift; collection="$1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  [ -z "$collection" ] && die "Usage: bapXphp add <field>:<type> [modifiers] under <collection>"
  [ ${#args[@]} -eq 0 ] && die "Missing field spec. Usage: bapXphp add <field>:<type> under <collection>"

  field_spec="${args[0]}"
  local field_name="${field_spec%%:*}"
  local field_type="${field_spec#*:}"

  [ -z "$field_name" ] && die "Field name is required"
  [ -z "$field_type" ] && die "Field type is required (e.g. string, number, boolean, email, text, slug, url, datetime)"

  local required="false"
  local enum_values=""
  local items_type=""

  for ((i=1; i<${#args[@]}; i++)); do
    case "${args[$i]}" in
      required:*) required="${args[$i]#required:}" ;;
      values:*)   enum_values="${args[$i]#values:}" ;;
      items:*)    items_type="${args[$i]#items:}" ;;
    esac
  done

  [ -f "$SCHEMA_FILE" ] || die "Schema file not found: $SCHEMA_FILE"

  php -r "
    \$path = '$SCHEMA_FILE';
    \$s = json_decode(file_get_contents(\$path), true);
    if (!isset(\$s['collections']['$collection'])) {
      fprintf(STDERR, \"Collection '$collection' not found\n\"); exit(1);
    }
    if (isset(\$s['collections']['$collection']['fields']['$field_name'])) {
      fprintf(STDERR, \"Field '$field_name' already exists in '$collection'\n\"); exit(1);
    }
    \$def = ['type' => '$field_type'];
    if ('$required' === 'true') \$def['required'] = true;
    if ('$enum_values' !== '') \$def['values'] = explode(',', '$enum_values');
    if ('$items_type' !== '') \$def['items'] = '$items_type';
    \$s['collections']['$collection']['fields']['$field_name'] = \$def;
    file_put_contents(\$path, json_encode(\$s, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . \"\n\");
    echo \"Added $field_name: $field_type to $collection\n\";
  "
}

cmd_remove() {
  local field_name="" collection=""
  local args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      under) shift; collection="$1" ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  [ -z "$collection" ] && die "Usage: bapXphp remove <field> under <collection>"
  [ ${#args[@]} -eq 0 ] && die "Missing field name. Usage: bapXphp remove <field> under <collection>"

  field_name="${args[0]}"
  [ -f "$SCHEMA_FILE" ] || die "Schema file not found: $SCHEMA_FILE"

  php -r "
    \$path = '$SCHEMA_FILE';
    \$s = json_decode(file_get_contents(\$path), true);
    if (!isset(\$s['collections']['$collection'])) {
      fprintf(STDERR, \"Collection '$collection' not found\n\"); exit(1);
    }
    if (!isset(\$s['collections']['$collection']['fields']['$field_name'])) {
      fprintf(STDERR, \"Field '$field_name' not found in '$collection'\n\"); exit(1);
    }
    unset(\$s['collections']['$collection']['fields']['$field_name']);

    // Clean up related arrays
    foreach (['admin_fields', 'media_fields', 'agent_context'] as \$key) {
      if (isset(\$s['collections']['$collection'][\$key])) {
        \$s['collections']['$collection'][\$key] = array_values(array_filter(
          \$s['collections']['$collection'][\$key],
          fn(\$v) => \$v !== '$field_name'
        ));
        if (empty(\$s['collections']['$collection'][\$key])) unset(\$s['collections']['$collection'][\$key]);
      }
    }
    file_put_contents(\$path, json_encode(\$s, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . \"\n\");
    echo \"Removed $field_name from $collection\n\";
  "
}

# ── Tool Commands ──────────────────────────────────────────────
cmd_tool() {
  local action="${1:-list}"
  shift 2>/dev/null || true
  case "$action" in
    list) cmd_tool_list ;;
    add)  cmd_tool_add "$1" ;;
    *)    cmd_tool_list ;;
  esac
}

cmd_tool_list() {
  echo "Tools in $ROOT/tools/:"
  echo ""
  for f in "$ROOT/tools/"*.php; do
    [ -f "$f" ] || continue
    local name
    name=$(basename "$f") || true
    local desc
    desc=$(head -3 "$f" | sed -n 's/.*\* *//p' | head -1) || true
    printf "  %s  %s\n" "$name" "$desc"
  done
  [ -x "$ROOT/tools/bapXphp" ] && printf "  %s  %s\n" "bapXphp" "Project management CLI"
}

cmd_tool_add() {
  local filename="$1"
  [ -z "$filename" ] && die "Usage: bapXphp tool add <filename.php>"

  # Ensure .php extension
  [[ "$filename" == *.php ]] || filename="${filename}.php"
  local filepath="$ROOT/tools/$filename"

  [ -f "$filepath" ] && die "File already exists: $filepath"

  # Create template
  cat > "$filepath" << 'TEMPLATE'
<?php
/**
 * Short description of this tool.
 *
 * Usage: php tools/__FILE__
 */

require __DIR__ . '/../app/bootstrap.php';

// Your tool logic here
echo "Tool ready.\n";
TEMPLATE

  # Replace placeholder
  sed -i '' "s/__FILE__/$filename/" "$filepath"

  # Open in nano for editing
  nano "$filepath"

  # Validate
  if php -l "$filepath" 2>&1; then
    chmod +x "$filepath"
    ok "Created and validated: tools/$filename"
  else
    err "PHP syntax errors in $filename. Fix with: nano tools/$filename"
    exit 1
  fi
}

# ── Dev Commands ───────────────────────────────────────────────
cmd_test() {
  require_php
  php "$ROOT/tests/run.php" 2>&1
}

cmd_lint() {
  require_php
  local target="${1:-}"
  if [ -n "$target" ]; then
    if [ -f "$target" ]; then
      php -l "$target"
    else
      find "$target" -name '*.php' -exec php -l {} \; 2>&1 | grep -v 'No syntax errors'
    fi
  else
    find "$ROOT/app" "$ROOT/api" "$ROOT/tests" "$ROOT/tools" "$ROOT/views" "$ROOT/index.php" -name '*.php' 2>/dev/null \
      -exec php -l {} \; 2>&1 | grep -v 'No syntax errors'
    ok "PHP syntax check complete"
  fi
}

cmd_check() {
  require_php
  local failed=0

  echo "── lint ──"
  cmd_lint || { failed=1; warn "LINT FAILED"; }

  echo "── test ──"
  cmd_test || { failed=1; warn "TESTS FAILED"; }

  echo "── map:gen ──"
  php "$ROOT/tools/generate-project-map.php" 2>&1 || { failed=1; warn "MAP GEN FAILED"; }

  echo "── map:val ──"
  php "$ROOT/tools/validate-project-map.php" 2>&1 || { failed=1; warn "MAP VALIDATION FAILED"; }

  echo "── smoke ──"
  php "$ROOT/tools/smoke-local.php" 2>&1 || { failed=1; warn "SMOKE FAILED"; }

  if [ "$failed" -eq 0 ]; then
    ok "ALL CHECKS PASSED"
  else
    err "SOME CHECKS FAILED"
    exit 1
  fi
}

cmd_serve() {
  require_php
  echo "Starting dev server at http://127.0.0.1:6020"
  php -S 127.0.0.1:6020 -t "$ROOT" "$ROOT/index.php"
}

cmd_smoke() {
  require_php
  php "$ROOT/tools/smoke-local.php" 2>&1
}

