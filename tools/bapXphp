# ── db query <collection> [--where "field=value"] [--limit N] [--id id] [--owner email]
# ────────────────────────────────────────────────────────────────
# Queries a collection. Tries MySQL first, falls back to reading JSON file.
#   --where "field=value"   — filter records where _data->>"$.field" matches value
#   --id <id>               — shorthand: find by id column
#   --owner <email>         — shorthand: find by _owner column
#   --limit N               — max records to return (default: 50)
#   --json                  — output raw JSON (one record per line)
cmd_db_query() {
  require_php
  local collection="" where="" id_val="" owner_val="" limit=50 json_output=false
  local args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --where)    shift; where="$1" ;;
      --id)       shift; id_val="$1" ;;
      --owner)    shift; owner_val="$1" ;;
      --limit)    shift; limit="$1" ;;
      --json)     json_output=true ;;
      *)          args+=("$1") ;;
    esac
    shift
  done

  collection="${args[0]:-}"
  [ -z "$collection" ] && die "Usage: bapXphp db query <collection> [--where 'f=v'] [--id id] [--owner email] [--limit N]"

  # ── Try MySQL first (tunnel → direct) ──
  php -r "
    \$table = preg_replace('/[^a-z_]/', '', '$collection');
    \$dsns = [
      'mysql:host=127.0.0.1;port=$MYSQL_TUNNEL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
      'mysql:host=$MYSQL_HOST;port=$MYSQL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
    ];
    \$pdo = null;
    foreach (\$dsns as \$dsn) {
      try { \$pdo = new PDO(\$dsn, '$MYSQL_USER', '$MYSQL_PASS', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_TIMEOUT => 3]); break; } catch (Exception \$e) {}
    }

    if (!\$pdo) { exit(1); }

    \$sql = \"SELECT * FROM \`{\$table}\` WHERE 1=1\";
    \$params = [];

    if ('$id_val') {
      \$sql .= ' AND id = ?';
      \$params[] = '$id_val';
    }
    if ('$owner_val') {
      \$sql .= ' AND _owner = ?';
      \$params[] = '$owner_val';
    }
    if ('$where' && strpos('$where', '=') !== false) {
      list(\$wf, \$wv) = explode('=', '$where', 2);
      \$wf = trim(\$wf); \$wv = trim(\$wv);
      \$sql .= ' AND _data LIKE ?';
      \$params[] = '%\"' . \$wf . '\":\"' . \$wv . '\"%';
    }

    \$sql .= ' LIMIT ' . (int)'$limit';
    \$stmt = \$pdo->prepare(\$sql);
    \$stmt->execute(\$params);
    \$rows = \$stmt->fetchAll(PDO::FETCH_ASSOC);

    if (count(\$rows) === 0) {
      echo \"No records found in \$table.\n\";
      exit(0);
    }

    echo \"Found \" . count(\$rows) . \" records in \$table:\n\n\";
    foreach (\$rows as \$row) {
      \$data = json_decode(\$row['_data'], true) ?: [];
      if ('$json_output' === 'true') {
        echo json_encode(\$data, JSON_UNESCAPED_UNICODE) . \"\n\";
      } else {
        echo \"  ID:   \" . (\$data['id'] ?? \$row['id']) . \"\n\";
        echo \"  File: \$table.json\" . \"\n\";
        foreach (\$data as \$k => \$v) {
          if (\$k === 'id') continue;
          \$val = is_array(\$v) ? json_encode(\$v) : \$v;
          echo \"  \$k: \$val\n\";
        }
        echo \"  ---\n\";
      }
    }
  " && return

  # ── MySQL only — die if unreachable ──
  die "MySQL unreachable. Start tunnel: bapXphp db tunnel"
}

# ── db find <collection> <id> ───────────────────────────────────
# Shorthand for bapXphp db query <collection> --id <id>
cmd_db_find() {
  local collection="$1" id="$2"
  [ -z "$collection" ] && die "Usage: bapXphp db find <collection> <id>"
  [ -z "$id" ] && die "Usage: bapXphp db find <collection> <id>"
  cmd_db_query "$collection" --id "$id"
}

# ── db raw <sql> — Execute raw SQL on remote MySQL ──────────────
# Connects to MySQL (tunnel first, then direct) and executes arbitrary SQL.
# Results are output as JSON lines.
cmd_db_raw() {
  local sql="$*"
  [ -z "$sql" ] && die "Usage: bapXphp db raw \"SELECT ...\""

  php -r "
    \$dsns = [
      'tunnel' => 'mysql:host=127.0.0.1;port=$MYSQL_TUNNEL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
      'direct' => 'mysql:host=$MYSQL_HOST;port=$MYSQL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
    ];
    \$pdo = null;
    foreach (\$dsns as \$dsn) {
      try {
        \$pdo = new PDO(\$dsn, '$MYSQL_USER', '$MYSQL_PASS', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_TIMEOUT => 5]);
        break;
      } catch (Exception \$e) {}
    }
    if (!\$pdo) { fprintf(STDERR, \"Cannot connect to MySQL. Start tunnel: bapXphp db tunnel\n\"); exit(1); }

    \$stmt = \$pdo->query(\"$sql\");
    if (\$stmt->columnCount() > 0) {
      while (\$row = \$stmt->fetch(PDO::FETCH_ASSOC)) {
        echo json_encode(\$row, JSON_UNESCAPED_UNICODE) . \"\n\";
      }
    } else {
      echo \"Query executed. Rows affected: \" . \$stmt->rowCount() . \"\n\";
    }
  "
}

# ── db init — Create MySQL tables from collections.json ─────────
# Reads the schema file, creates MySQL tables with _data JSON column
# and indexed columns for commonly queried fields.
cmd_db_init() {
  require_php
  echo "Creating MySQL tables from collections.json schema..."
  php -r "
    \$dsns = [
      'mysql:host=127.0.0.1;port=$MYSQL_TUNNEL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
      'mysql:host=$MYSQL_HOST;port=$MYSQL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
    ];
    \$pdo = null;
    foreach (\$dsns as \$dsn) {
      try { \$pdo = new PDO(\$dsn, '$MYSQL_USER', '$MYSQL_PASS', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]); break; } catch (Exception \$e) {}
    }
    if (!\$pdo) { fprintf(STDERR, \"Cannot connect to MySQL. Start tunnel: bapXphp db tunnel\n\"); exit(1); }

    \$schema = json_decode(file_get_contents('$SCHEMA_FILE'), true);
    foreach (\$schema['collections'] as \$name => \$col) {
      \$table = preg_replace('/[^a-z_]/', '', \$name);
      \$pdo->exec(\"CREATE TABLE IF NOT EXISTS {\$table} (
        id VARCHAR(36) PRIMARY KEY,
        _data JSON NOT NULL,
        _owner VARCHAR(255) DEFAULT NULL,
        _status VARCHAR(50) DEFAULT NULL,
        _created_at DATETIME DEFAULT NULL,
        _updated_at DATETIME DEFAULT NULL,
        INDEX idx_owner (_owner),
        INDEX idx_status (_status),
        INDEX idx_created (_created_at)
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci\");
      echo \"  CREATED TABLE \$table\n\";
    }
    echo \"Done. \" . count(\$schema['collections']) . \" tables created.\n\";
  "
}

# ── db sync — Push JSON data files → MySQL tables ──────────────
# Reads every JSON data file defined in collections.json and inserts
# records into the corresponding MySQL table (INSERT IGNORE).
cmd_db_sync() {
  require_php

  # Test connection
  php -r "
    \$dsns = [
      'mysql:host=127.0.0.1;port=$MYSQL_TUNNEL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
      'mysql:host=$MYSQL_HOST;port=$MYSQL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
    ];
    foreach (\$dsns as \$dsn) {
      try { new PDO(\$dsn, '$MYSQL_USER', '$MYSQL_PASS', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_TIMEOUT => 5]); echo \"OK\n\"; exit(0); } catch (Exception \$e) {}
    }
    echo \"FAIL\n\"; exit(1);
  " 2>/dev/null || die "Cannot connect to MySQL. Start tunnel: bapXphp db tunnel"

  echo "Pushing JSON collections into MySQL..."
  php -r "
    \$schema = json_decode(file_get_contents('$SCHEMA_FILE'), true);

    // Connect (tunnel first, then direct)
    \$dsns = [
      'mysql:host=127.0.0.1;port=$MYSQL_TUNNEL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
      'mysql:host=$MYSQL_HOST;port=$MYSQL_PORT;dbname=$MYSQL_DB;charset=utf8mb4',
    ];
    \$pdo = null;
    foreach (\$dsns as \$dsn) {
      try { \$pdo = new PDO(\$dsn, '$MYSQL_USER', '$MYSQL_PASS', [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]); break; } catch (Exception \$e) {}
    }

    \$total = 0;
    foreach (\$schema['collections'] as \$name => \$col) {
      \$jsonFile = \$col['file'] ?? ('storage/data/' . \$name . '.json');
      \$fullPath = '$ROOT/' . \$jsonFile;
      if (!is_file(\$fullPath)) { echo \"  SKIP \$name (no file)\n\"; continue; }
      \$records = json_decode(file_get_contents(\$fullPath), true) ?: [];

      \$table = preg_replace('/[^a-z_]/', '', \$name);

      // Ensure table exists
      \$pdo->exec(\"CREATE TABLE IF NOT EXISTS {\$table} (
        id VARCHAR(36) PRIMARY KEY,
        _data JSON NOT NULL,
        _owner VARCHAR(255) DEFAULT NULL,
        _status VARCHAR(50) DEFAULT NULL,
        _created_at DATETIME DEFAULT NULL,
        _updated_at DATETIME DEFAULT NULL
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4\");

      // Insert records
      \$count = 0;
      \$stmt = \$pdo->prepare(\"INSERT IGNORE INTO {\$table} (id, _data, _owner, _status, _created_at, _updated_at) VALUES (?, ?, ?, ?, ?, NOW())\");
      foreach (\$records as \$rec) {
        \$id = \$rec['id'] ?? (\$rec[\$col['primary_key'] ?? 'id'] ?? uniqid());
        \$owner = \$rec[\$col['owner_field'] ?? ''] ?? \$rec['customer_email'] ?? null;
        \$status = \$rec['status'] ?? null;
        \$created = \$rec['created_at'] ?? null;
        \$stmt->execute([\$id, json_encode(\$rec), \$owner, \$status, \$created]);
        \$count++;
      }
      echo \"  \$count records → \$table\n\";
      \$total += \$count;
    }
    echo \"Done. \$total total records synced.\n\";
  "
}

