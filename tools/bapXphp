# ═══════════════════════════════════════════════════════════════
# Deploy & SSH
# ═══════════════════════════════════════════════════════════════
cmd_deploy() {
  if ! ssh_reachable; then
    warn "Production server $SSH_HOST not reachable"
    warn "Deploy will attempt git push + remote commands"

    # Fallback: just git push
    echo "Pushing to origin main..."
    git -C "$ROOT" push origin main 2>&1 || warn "Push failed. Check git remote."
    echo ""
    echo "After server is reachable, run:"
    echo "  ssh -p $SSH_PORT ${SSH_USER}@${SSH_HOST} \"cd ~/domains/sripanchamispiritual.com && git pull origin main\""
    echo "  ssh -p $SSH_PORT ${SSH_USER}@${SSH_HOST} \"cd ~/domains/sripanchamispiritual.com && php tools/generate-project-map.php\""
    return
  fi

  echo "Deploying to production..."
  echo ""

  # Push to git
  git -C "$ROOT" push origin main 2>&1 || warn "Git push had issues"

  # Remote pull + post-deploy
  remote_sh "cd ~/domains/sripanchamispiritual.com && git pull origin main 2>&1" || warn "Remote git pull failed"
  remote_sh "cd ~/domains/sripanchamispiritual.com && php tools/generate-project-map.php 2>&1" || true
  echo ""
  ok "Deploy complete"
}

cmd_ssh() {
  echo "Connecting to ${SSH_USER}@${SSH_HOST}:${SSH_PORT}"
  echo "Password: ${SSH_PASS}"
  echo ""

  if command -v sshpass >/dev/null 2>&1; then
    sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no -p "$SSH_PORT" "${SSH_USER}@${SSH_HOST}"
  else
    warn "sshpass not found. Install: brew install hudochenkov/sshpass/sshpass"
    ssh -p "$SSH_PORT" "${SSH_USER}@${SSH_HOST}"
  fi
}

# ── Main Dispatch ──────────────────────────────────────────────
main() {
  [ $# -eq 0 ] && set -- help

  case "$1" in
    help|--help|-h)
      cmd_help ;;
    understand|context)
      cmd_"$1" ;;
    schema|add|remove|tool)
      local cmd="$1"; shift
      "cmd_${cmd}" "$@" ;;
    test|lint|check|serve|smoke)
      cmd_"$1" ;;
    map)
      cmd_map ;;
    map:gen|mapgen)
      cmd_map_gen ;;
    map:val|mapval)
      cmd_map_val ;;
    skills)
      cmd_skills ;;
    route:list|routes)
      cmd_route_list ;;
    status)
      cmd_status ;;
    logs)
      cmd_logs ;;
    issue|pr|merge)
      cmd_"$1" ;;
    mail:process|mail-process)
      cmd_mail_process ;;
    images:optimize|images-optimize|imgopt)
      cmd_images_optimize ;;
    db)
      shift; cmd_db "$@" ;;
    # Backward compatibility: mysql:* aliases
    mysql:tunnel|mysql-tunnel)
      warn "[DEPRECATED] Use 'bapXphp db tunnel' instead"
      cmd_db_tunnel ;;
    mysql:query|mysql-query)
      warn "[DEPRECATED] Use 'bapXphp db raw' instead"
      shift; cmd_db_raw "$@" ;;
    mysql:import|mysql-import)
      warn "[DEPRECATED] Use 'bapXphp db sync' instead"
      cmd_db_sync ;;
    docsmap)
      cmd_docsmap ;;
    bloggen)
      cmd_bloggen ;;
    deploy)
      cmd_deploy ;;
    ssh)
      cmd_ssh ;;
    *)
      err "Unknown command: $1"
      cmd_help
      exit 1 ;;
  esac
}

main "$@"
