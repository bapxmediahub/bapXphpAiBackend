# ── Colors ─────────────────────────────────────────────────────
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; B='\033[1m'; N='\033[0m'

# ── Helpers ────────────────────────────────────────────────────
hr()  { printf "%$(tput cols)s\n" | tr ' ' '═'; }
hr2() { printf "%$(tput cols)s\n" | tr ' ' '─'; }
info() { printf "${C}%s${N}\n" "$*"; }
ok()   { printf "${G}%s${N}\n" "$*"; }
warn() { printf "${Y}%s${N}\n" "$*" >&2; }
err()  { printf "${R}%s${N}\n" "$*" >&2; }

die()  { err "$*"; exit 1; }

