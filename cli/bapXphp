# ── Logs ────────────────────────────────────────────────────────
cmd_logs() {
  local mode="remote" limit=20
  while [ $# -gt 0 ]; do
    case "$1" in
      --local) mode="local" ;;
      --limit) shift; limit="${1:-20}" ;;
      *) die "Usage: bapXphp logs [--limit N|--local]" ;;
    esac
    shift
  done

  if [ "$mode" = "remote" ]; then
    [[ "$limit" =~ ^[0-9]+$ ]] || die "--limit must be a positive integer"
    [ "$limit" -gt 0 ] || die "--limit must be a positive integer"
    info "Live production audit events (remote MySQL):"
    cmd_db_raw "SELECT * FROM audit_events ORDER BY _created_at DESC LIMIT $limit"
    return
  fi

  local logfiles
  logfiles=$(find "$ROOT/storage/logs" -maxdepth 1 -type f -name '*.log' 2>/dev/null | head -5)
  [ -f "$ROOT/server.log" ] && logfiles="${logfiles}${logfiles:+$'\n'}$ROOT/server.log"
  if [ -z "$logfiles" ]; then
    echo "No local development logs found."
  else
    for f in $logfiles; do
      echo "── $(basename "$f") (last 20 lines) ──"
      tail -20 "$f" 2>/dev/null || echo "(empty)"
      echo ""
    done
  fi
}

cmd_artifacts_clean() {
